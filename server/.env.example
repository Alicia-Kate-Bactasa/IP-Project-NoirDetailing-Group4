# =========================================================================
# NOIR DETAILING - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and insert your local or production credentials.
# DO NOT COMMIT THE REAL .env FILE TO GIT!
# =========================================================================

# Server Configuration
PORT=5001
NODE_ENV=development

# Database Connection (PostgreSQL / Neon / Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/noir_detailing_db?schema=public"

# Authentication & Security Secrets
# Use a strong, random 64-character secret key in production
JWT_SECRET="your_secure_jwt_secret_key_here"

# PayMongo Payment Gateway Sandbox Secrets (GCash, Maya, Cards in PH)
# Register for free at https://dashboard.paymongo.com for test keys
PAYMONGO_SECRET_KEY="sk_test_your_paymongo_secret_key"
PAYMONGO_PUBLIC_KEY="pk_test_your_paymongo_public_key"

# Comma-separated allowed browser origins for CORS (required in production if
# the SPA is hosted on a different origin than the API; empty is fine when the
# Express server serves the built SPA same-origin / via the Apache proxy).
ALLOWED_ORIGIN=""

# Public origin of the SPA. Used for links inside billing emails and as the
# PayMongo return URL fallback. No trailing slash.
PUBLIC_APP_URL="http://localhost:5173"

# Interactive API documentation (Swagger UI at /api-docs).
# Set to "false" to disable it, e.g. on a locked-down production deployment.
ENABLE_API_DOCS="true"

# -------------------------------------------------------------------------
# Recurring VIP billing (Option C: saved-card autopay + auto-invoice fallback)
# -------------------------------------------------------------------------
# Master switch for the daily node-cron billing sweep.
AUTO_BILLING_ENABLED="true"

# SAFETY DEFAULT: true = the job only logs what it would do. Nothing is charged
# and nothing is written. Set to "false" only once you have tested a dry run.
AUTO_BILLING_DRY_RUN="true"

# Cron schedule for the sweep. Default: every day at 08:00 studio time.
AUTO_BILLING_CRON="0 8 * * *"

# IANA timezone used for billing dates and the cron schedule.
BUSINESS_TIMEZONE="Asia/Manila"

# Monthly VIP membership fee in PHP (server-side amount; clients cannot override).
SUBSCRIPTION_MONTHLY_FEE="1500"

# Days of VIP access kept after a failed/unpaid renewal before the plan expires.
AUTO_BILLING_GRACE_DAYS="5"

# Day offsets (since the billing date) at which a failed card charge is retried.
# The last offset also bounds the auto-invoice dunning window.
AUTO_BILLING_RETRY_DAYS="0,3,7"

# Send a "your membership renews soon" email this many days before renewal.
# Set to 0 to disable renewal reminders.
AUTO_BILLING_REMINDER_DAYS="3"

# SMTP / Email (transactional + OTP emails). Gmail example:
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_app_specific_password"
SMTP_FROM='"Noir Detailing" <your_email@gmail.com>'
